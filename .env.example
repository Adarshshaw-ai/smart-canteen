# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_canteen_db
DB_PASSWORD=your_password_here

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (Optional for future use)
