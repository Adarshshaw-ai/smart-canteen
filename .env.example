# Client Configuration (for Vite)
VITE_API_URL=http://localhost:5000/api

# Optional: Razorpay or other payment gateway credentials
# RAZORPAY_KEY_ID=your_key_here
# RAZORPAY_KEY_SECRET=your_secret_here
